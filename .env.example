# SafeSpot backend (Fastify + Prisma). Any of the Vercel/Neon Postgres URL names
# are picked up automatically by src/config.ts and scripts/prisma-with-env.mjs:
#   DATABASE_URL, POSTGRES_PRISMA_URL, POSTGRES_URL,
#   safespot_db_prod_POSTGRES_PRISMA_URL, safespot_db_prod_POSTGRES_URL, safespot_db_prod_DATABASE_URL
DATABASE_URL="postgresql://safespot:safespot@localhost:5432/safespot?schema=public"
# Direct (non-pooling) URL used by Prisma migrations when the main URL is pooled:
# DIRECT_URL="postgresql://..."

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRATION_MS=86400000

PORT=3000
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:4173"
TRUST_PROXY=false

# Optional one-off seed values used by npm run db:seed:company.
SEED_COMPANY_SLUG="safety-man"
SEED_COMPANY_NAME="safety-man"
SEED_USER_NAME="jimmcd"
SEED_USER_EMAIL=""
SEED_USER_PASSWORD="replace-before-running"
SEED_ROLE="MANAGER"
SEED_TEAM_NAME="Safety Management"
